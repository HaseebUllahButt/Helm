    { "src": "/icon-512.png?v=7", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png?v=7", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg?v=7", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
