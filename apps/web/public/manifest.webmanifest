{
  "name": "helm",
  "short_name": "helm",
  "description": "Control your coding agents on every machine you own.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "orientation": "portrait",
