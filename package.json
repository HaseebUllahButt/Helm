{
  "name": "helm-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && bash test/network.sh",
    "check": "npm exec --workspace @helm/web -- tsc --noEmit && npm --workspace @helm/web run build && npm test",
    "web": "npm --workspace @helm/web run dev"

  }
}
