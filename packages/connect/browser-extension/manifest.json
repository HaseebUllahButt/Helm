{
  "manifest_version": 3,
  "name": "Helm",
  "description": "Lets your Helm agents use tabs in this browser, with your own logins.",
  "version": "1.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "action": { "default_title": "Helm" }
}
